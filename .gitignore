# Môi trường và thư viện cài trên máy (giữ requirements/package-lock trong Git)
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]

# Cấu hình riêng / thông tin xác thực (chỉ cho phép mẫu không chứa bí mật)
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Toàn bộ dữ liệu triển lãm, kể cả mask / file staging phát sinh về sau
/backend/storage/*
!/backend/storage/drawings/
/backend/storage/drawings/**
!/backend/storage/drawings/.gitkeep
!/backend/storage/snapshots/
/backend/storage/snapshots/**
!/backend/storage/snapshots/.gitkeep

# Dữ liệu / bản sao lưu riêng nếu đặt trong thư mục dự án
/storage/
/backups/
/local/

# Tệp riêng của hệ điều hành và trình soạn thảo
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Cache / kết quả chạy test, không phải mã test
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.nyc_output/
playwright-report/
test-results/
*.log
*.pid

# Giữ .impeccable/design.json dùng chung; chỉ bỏ bằng chứng và cấu hình local
/.impeccable/review/
/.impeccable/mocks/
/.impeccable/build/
/.impeccable/config.local.json
/benchmarks/results/

# Công cụ/skill/connector cục bộ, không cần để chạy ứng dụng
/.agents/
/.codex/
/.c2c/
/.cloudflared/
/skills-lock.json

# Môi trường Python cục bộ
.venv/
__pycache__/
*.pyc

# Dữ liệu sinh ra khi chạy ứng dụng
backend/storage/drawings/*
backend/storage/snapshots/*
backend/storage/state.json
backend/storage/state.*.json
backend/storage/*.tmp
backend/storage/vectors/
backend/storage/favorites/
backend/storage/admin-secret*

# Giữ lại các thư mục lưu trữ rỗng
!backend/storage/drawings/.gitkeep
!backend/storage/snapshots/.gitkeep

# Tệp riêng của hệ điều hành và trình soạn thảo
.DS_Store
.vscode/
.idea/
.pytest_cache/
.ruff_cache/
coverage/
*.log

# Browser tests only; no generated files belong in the production frontend.
node_modules/
